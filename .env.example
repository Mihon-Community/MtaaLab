# MtaaLab local environment template. Copy this once to the repository root as .env.
# Backend-only credentials: never move these into VITE_* variables.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

SUPABASE_URL=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

AT_USERNAME=sandbox
AT_API_KEY=
AT_TEST_PHONE=+2547XXXXXXXX
WEBHOOK_TOKEN=
PHONE_HMAC_SECRET=
PHONE_ENCRYPTION_KEY=
MOBILE_JOIN_CODE_PEPPER=
AT_USSD_SERVICE_CODE=
AT_ALLOWED_PHONES=
RATE_LIMIT_PER_MINUTE=

APP_ENV=development
PUBLIC_BASE_URL=https://YOUR_HTTPS_TUNNEL_OR_HOST
ALLOWED_ORIGINS=http://localhost:5173
BACKEND_HOST_PORT=8000

# VITE_* values are public and embedded in frontend browser assets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_me
VITE_API_BASE_URL=http://localhost:8000
